{
  "name": "portable-meme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun lint",
    "format": "bun --bun fmt",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:push": "bun --bun drizzle-kit push",
    "db:pull": "bun --bun drizzle-kit pull",
    "db:init": "bun --bun ./src/database/initialize.ts"
  },
  "dependencies": {
    "drizzle-orm": "^1.0.0-rc.5",
    "jose": "^6.2.13",
    "next": "^16.5.0-canary.24",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "drizzle-seed": "^1.0.0-rc.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
